// ---- Sekcja 4.1: krzywa XP — XP(poziom) = 3*poziom^2 + 47*poziom ----
function pipboyXpDoNastepnegoPoziomu(poziom) {
  const next = 3 * Math.pow(poziom + 1, 2) + 47 * (poziom + 1);
  const curr = 3 * Math.pow(poziom, 2) + 47 * poziom;
  return next - curr;
}

