// ============================================================
// CEREBRO — DriveSync.gs
// Automatyczny import i aktualizacja plików z Google Drive
// ============================================================

const KNOWLEDGE_FOLDER_ID = '1kKxkf4Z2k84zGGv_P8_tGYQIbPB2IlIo';

const FOLDER_CATEGORY_MAP = {
  'Procedury':  { kategoria: 'procedury',  tagi: 'procedury,import-drive' },
  'Cenniki':    { kategoria: 'cenniki',    tagi: 'cenniki,import-drive' },
  'Szablony':   { kategoria: 'szablony',   tagi: 'szablony,import-drive' },
  'Materiały':  { kategoria: 'materialy',  tagi: 'materialy,import-drive' },
  'Prywatne':   { kategoria: 'prywatne',   tagi: 'prywatne,import-drive' },
  'Notatki':    { kategoria: 'notatki',    tagi: 'notatki,import-drive' },
};

// Mapa: { fileId: { modifiedDate: string, knowledgeId: string } }
function getFileTrackingMap() {
  const stored = PropertiesService.getScriptProperties().getProperty('DRIVE_FILE_MAP');
  return stored ? JSON.parse(stored) : {};
}

function saveFileTrackingMap(map) {
  PropertiesService.getScriptProperties().setProperty('DRIVE_FILE_MAP', JSON.stringify(map));
}

function setupDriveFolders() {
  try {
    const folder = DriveApp.getFolderById(KNOWLEDGE_FOLDER_ID);

    // Utwórz podfoldery jeśli nie istnieją
    Object.keys(FOLDER_CATEGORY_MAP).forEach(name => {
      const existing = folder.getFoldersByName(name);
      if (!existing.hasNext()) folder.createFolder(name);
    });

    PropertiesService.getScriptProperties().setProperty('CEREBRO_FOLDER_ID', KNOWLEDGE_FOLDER_ID);
    return { success: true, folderId: KNOWLEDGE_FOLDER_ID };
  } catch(e) {
    return { success: false, error: e.toString() };
  }
}

function setupDriveTrigger() {
  try {
    ScriptApp.getProjectTriggers().forEach(trigger => {
      if (trigger.getHandlerFunction() === 'syncDriveFiles') {
        ScriptApp.deleteTrigger(trigger);
      }
    });
    ScriptApp.newTrigger('syncDriveFiles')
      .timeBased()
      .everyHours(1)
      .create();
    return { success: true };
  } catch(e) {
    return { success: false, error: e.toString() };
  }
}

function syncDriveFiles() {
  try {
    const folder = DriveApp.getFolderById(KNOWLEDGE_FOLDER_ID);
    const trackingMap = getFileTrackingMap();
    let imported = 0, updated = 0;

    // Pliki w głównym folderze → notatki
    const rootResult = _processFolder(
      folder,
      { kategoria: 'notatki', tagi: 'notatki,import-drive' },
      'Główny folder',
      trackingMap
    );
    imported += rootResult.imported;
    updated  += rootResult.updated;

    // Podfoldery
    const subfolders = folder.getFolders();
    while (subfolders.hasNext()) {
      const subfolder = subfolders.next();
      const folderName = subfolder.getName();
      const mapping = FOLDER_CATEGORY_MAP[folderName];
      if (!mapping) continue;

      const result = _processFolder(subfolder, mapping, folderName, trackingMap);
      imported += result.imported;
      updated  += result.updated;
    }

    saveFileTrackingMap(trackingMap);
    return { success: true, imported, updated };
  } catch(e) {
    return { success: false, error: e.toString() };
  }
}

function _processFolder(folder, mapping, folderLabel, trackingMap) {
  let imported = 0, updated = 0;
  const files = folder.getFiles();

  while (files.hasNext()) {
    const file = files.next();
    const fileId = file.getId();
    const modifiedDate = file.getLastUpdated().toISOString();
    const tracked = trackingMap[fileId];

    // Pomiń jeśli plik niezmieniony
    if (tracked && tracked.modifiedDate === modifiedDate) continue;

    const content = _readFileContent(file);
    const extraTags = _extractTagsFromFilename(file.getName());
    const allTags = [mapping.tagi, extraTags].filter(Boolean).join(',');
    const isPrivate = folderLabel === 'Prywatne';

    const entry = {
      tytul: file.getName().replace(/\.[^/.]+$/, ''),
      kategoria: mapping.kategoria,
      tagi: allTags,
      widocznosc: isPrivate ? 'prywatny' : 'udostepniony',
      tresc: content,
      zrodlo: 'Google Drive — ' + folderLabel
    };

    if (tracked && tracked.knowledgeId) {
      entry.id = tracked.knowledgeId;
      updateKnowledge(entry);
      trackingMap[fileId] = { modifiedDate, knowledgeId: tracked.knowledgeId };
      updated++;
    } else {
      const result = createKnowledge(entry);
      trackingMap[fileId] = { modifiedDate, knowledgeId: result.id };
      imported++;
    }
  }

  return { imported, updated };
}

function _readFileContent(file) {
  try {
    const mimeType = file.getMimeType();

    if (mimeType === 'application/vnd.google-apps.document') {
      return DocumentApp.openById(file.getId()).getBody().getText();
    }

    if (mimeType === 'text/plain' || mimeType === 'text/markdown') {
      return file.getBlob().getDataAsString('utf-8');
    }

    if (mimeType === 'application/vnd.google-apps.spreadsheet') {
      return _readSpreadsheetAsText(file.getId());
    }

    // PDF, zdjęcia, DOCX, XLSX i inne — metadane + link
    const typeLabel = {
      'application/pdf': 'PDF',
      'image/jpeg': 'Zdjęcie (JPEG)',
      'image/png':  'Zdjęcie (PNG)',
      'image/gif':  'Zdjęcie (GIF)',
      'image/webp': 'Zdjęcie (WebP)',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document':  'Word (DOCX)',
      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'Excel (XLSX)',
    }[mimeType] || mimeType;

    return [
      '[Typ: ' + typeLabel + ']',
      '[Rozmiar: ' + file.getSize() + ' B]',
      '[Dodano: ' + file.getDateCreated() + ']',
      '[Zaktualizowano: ' + file.getLastUpdated() + ']',
      '',
      'Link do pliku: ' + file.getUrl(),
    ].join('\n');

  } catch(err) {
    return '[Błąd odczytu: ' + err.toString() + ']\n\nLink do pliku: ' + file.getUrl();
  }
}

function _readSpreadsheetAsText(fileId) {
  try {
    const ss = SpreadsheetApp.openById(fileId);
    const lines = [];
    ss.getSheets().forEach(sheet => {
      lines.push('## ' + sheet.getName());
      const data = sheet.getDataRange().getValues();
      data.forEach(row => lines.push(row.join('\t')));
      lines.push('');
    });
    return lines.join('\n');
  } catch(e) {
    return '[Błąd odczytu arkusza: ' + e.toString() + ']';
  }
}

function _extractTagsFromFilename(filename) {
  const keywordMap = {
    'procedura': 'procedura',
    'cennik':    'cennik',
    'szablon':   'szablon',
    'umowa':     'umowa',
    'regulamin': 'regulamin',
    'instrukcja':'instrukcja',
    'raport':    'raport',
    'protokol':  'protokol',
    'zgoda':     'zgoda',
  };
  const lower = filename.toLowerCase();
  return Object.entries(keywordMap)
    .filter(([k]) => lower.includes(k))
    .map(([, v]) => v)
    .join(',');
}

function manualSyncDrive() {
  return syncDriveFiles();
}

// Resetuje mapę śledzenia — przy następnym syncу wszystkie pliki zostaną ponownie zaimportowane
function resetDriveSync() {
  PropertiesService.getScriptProperties().deleteProperty('DRIVE_FILE_MAP');
  return { success: true };
}
